rules_version = '2';
// Reglas de seguridad de Firestore para Dominó Conquista.
// Pegar en Firebase Console > Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil público (nombre/foto) legible por cualquier usuario autenticado;
    // solo el dueño lo modifica.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Historial privado de cada usuario.
      match /historial/{partidaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /salas/{codigo} {
      allow read: if request.auth != null;

      // Solo se puede crear una sala siendo su anfitrión.
      allow create: if request.auth != null
                    && request.resource.data.anfitrionId == request.auth.uid
                    && request.resource.data.jugadorIds == [request.auth.uid];

      // Participantes pueden actualizar (jugadas); un no participante solo puede
      // agregarse mientras la sala está esperando.
      allow update: if request.auth != null && (
                      request.auth.uid in resource.data.jugadorIds
                      || (resource.data.estado == 'ESPERANDO'
                          && request.auth.uid in request.resource.data.jugadorIds)
                    );

      allow delete: if request.auth != null && request.auth.uid == resource.data.anfitrionId;

      // Log opcional de jugadas (útil para el informe / depuración).
      match /movimientos/{n} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/salas/$(codigo)).data.jugadorIds;
      }
    }
  }
}
